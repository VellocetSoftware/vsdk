<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource VellocetBlack}" />
        <Setter Property="Foreground" Value="{DynamicResource VellocetSoftWhite}" />
        <Setter Property="FontFamily" Value="{DynamicResource VellocetFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource VellocetSoftWhite}" />
    </Style>

    <Style Selector="SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource VellocetMuted}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource VellocetRed}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource VellocetBlack}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="17,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VellocetWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VellocetLineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource VellocetFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource VellocetWhite}" />
        <Setter Property="Foreground" Value="{DynamicResource VellocetBlack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VellocetWhite}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource VellocetRed}" />
        <Setter Property="Foreground" Value="{DynamicResource VellocetBlack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VellocetRed}" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="Button:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource VellocetRed}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.36" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource VellocetWhite}" />
        <Setter Property="Foreground" Value="{DynamicResource VellocetBlack}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VellocetWhite}" />
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource VellocetRed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VellocetRed}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource VellocetNearBlack}" />
        <Setter Property="Foreground" Value="{DynamicResource VellocetSoftWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VellocetLineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
</Styles>
